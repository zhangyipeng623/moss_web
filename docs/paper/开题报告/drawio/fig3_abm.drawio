<mxfile host="app.diagrams.net" modified="2026-06-24T00:00:00.000Z" agent="Codex" version="30.2.4" type="device"><diagram name="图3 ABM 推荐参数反推模块设计"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="720" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="图3 ABM 推荐参数反推模块设计" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=PingFang SC;fontSize=26;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="260" y="20" width="760" height="50" as="geometry"/></mxCell><mxCell id="l1" value="输入与准备" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=PingFang SC;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="90" y="95" width="250" height="35" as="geometry"/></mxCell><mxCell id="l2" value="仿真与约束" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=PingFang SC;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="495" y="95" width="250" height="35" as="geometry"/></mxCell><mxCell id="l3" value="校准与输出" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=PingFang SC;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="900" y="95" width="250" height="35" as="geometry"/></mxCell><mxCell id="a" value="画像与观测数据&lt;br&gt;用户画像、内容数据、真实传播指标" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=8;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="80" y="155" width="270" height="95" as="geometry"/></mxCell><mxCell id="b" value="语义特征整理&lt;br&gt;价值立场、内容主题、兴趣匹配" style="rounded=1;whiteSpace=wrap;html=1;arcSize