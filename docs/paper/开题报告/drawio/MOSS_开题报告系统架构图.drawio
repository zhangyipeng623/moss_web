g SC;align=center;verticalAlign=middle;spacing=8;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="70" y="170" width="220" height="90" as="geometry"/></mxCell><mxCell id="n4" value="SemanticLoader<br>value_anchors → Kernel PCA<br>content_topics → 兴趣匹配" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=8;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="350" y="150" width="260" height="110" as="geometry"/></mxCell><mxCell id="n5" value="PopulationSynthesizer<br>Rogers 前16% 种子扩量<br>精英保留 + Zipf 影响力" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=8;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="350" y="320" width="260" height="110" as="geometry"/></mxCell><mxCell id="n6" value="StoryManager<br>代表性内容筛选<br>传播量归一化" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=8;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="350" y="500" width="260" height="100" as="geometry"/></mxCell><mxCell id="n7" value="Vectorized ABM Engine<br>score = w_i·interest + w_pop·pop<br>+ w_time·time + w_rand·random" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=8;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="710" y="230" width="340" height="120" as="geometry"/></mxCell><mxCell id="n8" value="机制约束<br>Per-Batch Min-Max<br>指数时间衰减<br>TIER_WEIGHT + Soft Backfire" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=8;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeom